# Copy this file to .env and fill in real values.
# .env is in .gitignore and should NEVER be committed or shared.

# Generate a new one for each environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# True for local development only. Must be False once this is live on a
# real domain - DEBUG=True leaks internal error details to any visitor.
DJANGO_DEBUG=True

# Comma-separated. For local dev: localhost,127.0.0.1
# For production: byumbaanglican.rw,www.byumbaanglican.rw (your real domain)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The frontend origin(s) allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only needed in production (DEBUG=False) - same domains as ALLOWED_HOSTS
# but with https:// in front.
CSRF_TRUSTED_ORIGINS=

# Database - leave blank to use SQLite (fine for local dev only).
# For production, set these to your PostgreSQL credentials.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
